<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M365 ToolKit Master Module"
        Height="760"
        Width="1180"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Padding="12"
                Margin="0,0,0,10"
                CornerRadius="8"
                Background="#FFFFFF"
                BorderBrush="#D7DEE8"
                BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Name="BtnRefresh"
                            Content="Refresh Catalog"
                            Width="130"
                            Height="34"
                            Margin="0,0,8,0" />
                    <Button Name="BtnRun"
                            Content="Run Selected"
                            Width="120"
                        Height="34"
                        Margin="0,0,12,0" />
                    <CheckBox Name="ChkNewWindow"
                          Content="Run in new PowerShell window"
                          VerticalAlignment="Center"
                          IsChecked="False" />
                </StackPanel>

                <TextBlock Name="TxtStatus"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#283041"
                           FontSize="13"
                           Text="Ready" />
            </DockPanel>
        </Border>

        <GroupBox Grid.Row="1"
                  Grid.Column="0"
                  Margin="0,0,12,10"
                  Header="Workloads"
                  Background="#FFFFFF"
                  BorderBrush="#D7DEE8"
                  BorderThickness="1">
            <Grid Margin="8">
                <ListBox Name="LstWorkloads"
                         FontSize="13"
                         BorderThickness="0" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1"
              Grid.Column="1"
              Margin="0,0,10,10"
                  Header="Actions"
                  Background="#FFFFFF"
                  BorderBrush="#D7DEE8"
                  BorderThickness="1">
            <Grid Margin="8">
                <DataGrid Name="GridActions"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Workload" Binding="{Binding Workload}" Width="140" />
                        <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="180" />
                        <DataGridTextColumn Header="Action" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="RunType" Binding="{Binding RunType}" Width="120" />
                        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Grid.Column="2"
                  Margin="0,0,0,10"
                  Header="Action Details"
                  Background="#FFFFFF"
                  BorderBrush="#D7DEE8"
                  BorderThickness="1">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="95" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Selected Action" FontWeight="SemiBold" Foreground="#283041" />
                <TextBlock Name="TxtSelectedAction" Grid.Row="1" Margin="0,4,0,8" Text="None" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Text="Target" FontWeight="SemiBold" Foreground="#283041" />
                <TextBlock Name="TxtSelectedTarget" Grid.Row="3" Margin="0,4,0,8" Text="" TextWrapping="Wrap" />

                <DockPanel Grid.Row="4" Margin="0,2,0,4">
                    <TextBlock Text="Arguments (one token per line)" FontWeight="SemiBold" Foreground="#283041" DockPanel.Dock="Left" />
                    <Button Name="BtnPreflight" Content="Run Preflight" Width="100" Height="26" DockPanel.Dock="Right" />
                </DockPanel>

                <TextBox Name="TxtArgs"
                         Grid.Row="5"
                         FontFamily="Consolas"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap" />

                <TextBox Name="TxtPreflight"
                         Grid.Row="6"
                         Margin="0,8,0,0"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         Text="Preflight not run." />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Grid.ColumnSpan="2"
                  Header="Execution Log"
                  Background="#FFFFFF"
                  BorderBrush="#D7DEE8"
                  BorderThickness="1">
            <Grid Margin="8">
                <TextBox Name="TxtLog"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>