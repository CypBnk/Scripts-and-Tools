<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M365 ToolKit Master Module"
        Height="760"
        Width="1180"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF2F8" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F4F6FA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D3DAE6" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E2638" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#4F5B70" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E20074" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#C40066" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#AA0058" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.62" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                Padding="12"
                Margin="0,0,0,10"
                CornerRadius="5"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Name="BtnRefresh"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Content="Refresh Catalog"
                            Width="130"
                            Height="34"
                            Margin="0,0,8,0" />
                    <Button Name="BtnRun"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Content="Run Selected"
                            Width="130"
                        Height="34"
                        Margin="0,0,12,0" />
                    <CheckBox Name="ChkNewWindow"
                          Content="Run in new PowerShell window"
                          VerticalAlignment="Center"
                          IsChecked="False" />
                </StackPanel>

                <TextBlock Name="TxtStatus"
                           DockPanel.Dock="Right"
                           TextAlignment="Right"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="13"
                           Text="Ready" />
            </DockPanel>
        </Border>

        <GroupBox Grid.Row="1"
                  Grid.Column="0"
                  Margin="0,0,10,10"
                  Header="Workloads"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
            <Grid Margin="8">
                <ListBox Name="LstWorkloads"
                         FontSize="13"
                         BorderThickness="0" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1"
              Grid.Column="1"
              Margin="0,0,10,10"
                  Header="Actions"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
            <Grid Margin="8">
                <DataGrid Name="GridActions"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          BorderBrush="{DynamicResource BorderBrush}"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Workload" Binding="{Binding Workload}" Width="140" />
                        <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="180" />
                        <DataGridTextColumn Header="Action" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="RunType" Binding="{Binding RunType}" Width="120" />
                        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Grid.Column="2"
                  Grid.RowSpan="2"
                  Margin="0,0,0,0"
                  Header="Action Details"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="95" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Selected Action" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Name="TxtSelectedAction" Grid.Row="1" Margin="0,4,0,8" Text="None" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Text="Target" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Name="TxtSelectedTarget" Grid.Row="3" Margin="0,4,0,8" Text="" TextWrapping="Wrap" />

                <DockPanel Grid.Row="4" Margin="0,2,0,4">
                    <TextBlock Text="Arguments (one token per line)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                    <Button Name="BtnPreflight" Style="{DynamicResource PrimaryButtonStyle}" Content="Run Preflight" Width="100" Height="26" DockPanel.Dock="Right" />
                </DockPanel>

                <TextBox Name="TxtArgs"
                         Grid.Row="5"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap" />

                <TextBox Name="TxtPreflight"
                         Grid.Row="6"
                         Margin="0,8,0,0"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         Text="Preflight not run." />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Grid.ColumnSpan="2"
                  Margin="0,0,10,0"
                  Header="Execution Log"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
            <Grid Margin="8">
                <TextBox Name="TxtLog"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>